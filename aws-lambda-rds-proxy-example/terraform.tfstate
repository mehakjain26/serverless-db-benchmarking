            "backup_encryption_key_crn": null,
            "backup_id": null,
            "configuration": null,
            "configuration_schema": "{\"schema\":{\"archive_timeout\":{\"default\":1800,\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"Generate a new transaction log segment and archive the old one if we haven't done so by this timeout value.  Roughly the maximum RPO.\",\"kind\":\"integer\",\"max\":1073741823,\"min\":300,\"requires_restart\":false,\"step\":null},\"deadlock_timeout\":{\"default\":10000,\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"Deadlock timeout in ms. The time to wait on a lock before checking for deadlock.  Also the duration where lock waits will be logged.\",\"kind\":\"integer\",\"max\":2147483647,\"min\":100,\"requires_restart\":false,\"step\":null},\"effective_io_concurrency\":{\"default\":12,\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"Number of simultaneous requests that can be handled efficiently by the disk subsystem.\",\"kind\":\"integer\",\"max\":1000,\"min\":1,\"requires_restart\":false,\"step\":null},\"log_connections\":{\"choices\":[\"off\",\"on\"],\"default\":\"off\",\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"Causes each attempted connection to the server to be logged, as well as successful completion of client authentication.\",\"kind\":\"choice\",\"requires_restart\":false},\"log_disconnections\":{\"choices\":[\"off\",\"on\"],\"default\":\"off\",\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"Causes session terminations to be logged. The log output provides information similar to log_connections, plus the duration of the session.\",\"kind\":\"choice\",\"requires_restart\":false},\"log_min_duration_statement\":{\"default\":100,\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"Sets the minimum execution time above which statements will be logged.\",\"kind\":\"integer\",\"max\":2147483647,\"min\":100,\"requires_restart\":false,\"step\":null},\"max_connections\":{\"default\":115,\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"Maximum connections allowed.\",\"kind\":\"integer\",\"max\":null,\"min\":115,\"requires_restart\":true,\"step\":null},\"max_locks_per_transaction\":{\"default\":64,\"default_description\":\"Historically proven sufficient. May need to raise if queries touch many different tables in a single transaction\",\"description\":\"This parameter controls the average number of object locks allocated for each transaction. No more than this many distinct objects can be locked at any one time\",\"kind\":\"integer\",\"max\":2147483647,\"min\":10,\"requires_restart\":true,\"step\":null},\"max_prepared_transactions\":{\"default\":0,\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"Max number of transactions that can be in the \\\"prepared\\\" state simultaneously.\",\"kind\":\"integer\",\"max\":null,\"min\":0,\"requires_restart\":true,\"step\":null},\"max_replication_slots\":{\"default\":10,\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"Maximum number of simultaneously defined replication slots.\",\"kind\":\"integer\",\"max\":262143,\"min\":10,\"requires_restart\":true,\"step\":null},\"max_wal_senders\":{\"default\":12,\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"Maximum number of simultaneously running WAL sender processes.\",\"kind\":\"integer\",\"max\":262143,\"min\":12,\"requires_restart\":true,\"step\":null},\"shared_buffers\":{\"default\":32000,\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"The number of 8kB shared memory buffers used by the server.  Set to 1/4 of memory as general guidance.  Setting too high will cause crashes or prevent the database from starting.\",\"kind\":\"integer\",\"max\":null,\"min\":16,\"requires_restart\":true,\"step\":null},\"synchronous_commit\":{\"choices\":[\"local\",\"on\",\"off\"],\"default\":\"local\",\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"Sets the current transaction's synchronization level.  Off can result in data loss.  On should only be used for formations with at least 3 members.  remote_write with enable synchronous replication which will impact performance and availabilty.\",\"kind\":\"choice\",\"requires_restart\":false},\"tcp_keepalives_count\":{\"default\":6,\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"The number of TCP keepalives that can be lost before the server's connection to the client is considered dead.\",\"kind\":\"integer\",\"max\":2147483647,\"min\":0,\"requires_restart\":false,\"step\":null},\"tcp_keepalives_idle\":{\"default\":300,\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"The number of seconds of inactivity after which TCP should send a keepalive message to the client.\",\"kind\":\"integer\",\"max\":2147483647,\"min\":0,\"requires_restart\":false,\"step\":null},\"tcp_keepalives_interval\":{\"default\":10,\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"The number of seconds after which a TCP keepalive message that is not acknowledged by the client should be retransmitted\",\"kind\":\"integer\",\"max\":2147483647,\"min\":0,\"requires_restart\":false,\"step\":null},\"wal_level\":{\"choices\":[\"replica\",\"logical\"],\"default\":\"replica\",\"default_description\":\"This property has no documentation for its default value.\",\"description\":\"WAL level. Allowed values are replica or logical.\",\"kind\":\"choice\",\"requires_restart\":true}}}",
